{
  "name": "physics-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "audit:deps": "npm audit --audit-level=moderate",
    "check:single-source": "node scripts/check-single-source.mjs --check",
    "check:naming": "node scripts/check-naming.mjs",
    "check:font-size": "node scripts/check-font-size.mjs",
    "check:no-raf": "node scripts/check-no-raf.mjs",
    "check:no-marker": "node scripts/check-no-marker.mjs",
    "check:component-reuse": "node scripts/check-component-reuse.mjs",
    "check:quantity-labels": "node scripts/check-quantity-labels.mjs",
    "check:control-meta": "node scripts/check-control-meta.mjs",
    "check:formula-condition": "node scripts/check-formula-condition.mjs",
    "check:runtime": "node scripts/check-runtime-ui.mjs",
    "check:seg-wrap": "node scripts/check-runtime-ui.mjs --only seg-wrap",
    "check:text-overlap": "node scripts/check-runtime-ui.mjs --only text-overlap",
    "check:architecture": "npm run check:font-size && npm run check:no-raf && npm run check:no-marker && npm run check:component-reuse && npm run check:quantity-labels && npm run check:control-meta && npm run check:formula-condition && npm run check:naming && npm run check:single-source",
    "check": "npm run build && npm test -- --run && npm run check:architecture && npm run check:runtime",
    "check:all": "npm run check && npm run audit:deps",
    "prepare": "lefthook install",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build:win": "vite build && tsc -p tsconfig.electron.json && electron-builder --win",
    "probe:seg-wrap": "node scripts/probe-seg-wrap.mjs"
  },
  "main": "electron-dist/main.js",
  "build": {
    "appId": "com.physics-learning.app",
    "productName": "物理学习",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "idb": "^8.0.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.460.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "electron": "^43.8.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
